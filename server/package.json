{
  "dependencies": {
    "@google/genai": "^1.35.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.3",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.5"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "find src -name '*.test.ts' -o -name '*.spec.ts' | xargs tsx --test",
    "test:coverage": "c8 npm test",
    "testCLI": "tsx --test src/**/*.test.ts src/**/*.spec.ts",
    "testCLI:coverage": "c8 npm testCLI"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "c8": "^10.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "**/*.test.ts",
      "node_modules"
    ]
  }
}
